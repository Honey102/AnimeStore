# AnimeStore — Environment Variables (Backend)
# Copy this as .env and fill in your values

# JWT Secret — use a long random string in production!
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Port (Render sets this automatically, no need to change)
PORT=5000

# Your Vercel frontend URL (for CORS)
FRONTEND_URL=https://your-animestore.vercel.app
